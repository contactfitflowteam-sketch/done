# ============================================================
#  AdMob production IDs — Android only
#  Fill in your REAL IDs from https://apps.admob.com/ before
#  running the "Build Android Release APK" GitHub Action.
# ============================================================

# 1) AdMob Android App ID (format ends with ~ then digits)
ADMOB_ANDROID_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX

# 2) Ad Unit IDs (format ends with / then digits)
EXPO_PUBLIC_ADMOB_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
EXPO_PUBLIC_ADMOB_NATIVE_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# 3) Ad mode: use "test" for testing APK, "production" for play store release
EXPO_PUBLIC_AD_MODE=test
